<section id="categories" class="hidden"><div class="card"><div class="top"><h2>الأقسام</h2><button class="btn primary" onclick="openCategory()">＋ قسم</button></div><div id="categoryList"></div></div></section>
<section id="orders" class="hidden"><div class="card"><h2>الطلبات</h2><div id="orderList"></div></div></section>
<section id="settings" class="hidden"><div class="card"><h2>إعدادات المتجر</h2><div class="grid"><div class="field"><label>شعار المتجر</label><input id="logoFile" type="file" accept="image/*"><div id="logoPreview" class="preview"></div></div><div class="field"><label>اسم المتجر</label><input id="storeName" value="BRITTON LIFE"></div><div class="field"><label>رقم التواصل</label><input id="storePhone"></div><div class="field"><label>البريد الإلكتروني</label><input id="storeEmail" type="email"></div><div class="field full"><label>رابط المتجر</label><input id="storeUrl" value="https://britton744.github.io/-/"></div></div><button class="btn primary" onclick="saveSettings()">حفظ الإعدادات</button></div></section>
<section id="appearance" class="hidden">
<div class="card"><h2>مظهر المتجر</h2><p class="muted">إدارة شعار المتجر وصورة الخلفية.</p>
<div class="grid">
<div class="field"><label>شعار المتجر</label><input id="appearanceLogo" type="file" accept="image/*"><div id="appearanceLogoPreview" class="preview"></div></div>
<div class="field"><label>صورة خلفية المتجر</label><input id="backgroundFile" type="file" accept="image/*"><div id="backgroundPreview" class="preview"></div></div>
<div class="field full"><label>رابط صورة الخلفية (اختياري)</label><input id="backgroundUrl" placeholder="https://..."></div>
</div><button class="btn primary" onclick="saveAppearance()">حفظ المظهر</button>
</div></section></main></div>
<div id="modal" class="modal hidden"><div class="modalbox"><div class="top"><h2 id="modalTitle">إضافة</h2><button class="btn" onclick="closeModal()">✕</button></div><div id="modalBody"></div></div></div><div id="toast" class="toast"></div>
<script type="module">
import{initializeApp}from"https://www.gstatic.com/firebasejs/10.12.5/firebase-app.js";
import{getAuth,onAuthStateChanged,signInWithEmailAndPassword,signOut,sendPasswordResetEmail}from"https://www.gstatic.com/firebasejs/10.12.5/firebase-auth.js";
import{getFirestore,collection,doc,getDocs,getDoc,addDoc,updateDoc,deleteDoc,setDoc}from"https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore.js";
import{getStorage,ref,uploadBytes,getDownloadURL}from"https://www.gstatic.com/firebasejs/10.12.5/firebase-storage.js";
const config={apiKey: "AIzaSyBPdzepXoNsfZuwvheHrhA6LynGJBctk_E",authDomain:"britton-life-store.firebaseapp.com",projectId:"britton-life-store",storageBucket:"britton-life-store.firebasestorage.app",messagingSenderId:"258780754601",appId:"1:258780754601:web:5c0d162547e64bd99d2fb8",measurementId:"G-RXK7K2Z4YT"};
const app=initializeApp(config),auth=getAuth(app),db=getFirestore(app),storage=getStorage(app),$=id=>document.getElementById(id);let user=null,products=[],categories=[],orders=[];
const msg=t=>{let x=$("toast");x.textContent=t;x.style.display="block";setTimeout(()=>x.style.display="none",3500)};
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function authError(e){const m={"auth/invalid-email":"صيغة البريد غير صحيحة.","auth/user-not-found":"هذا البريد غير مسجل في المشروع.","auth/wrong-password":"كلمة المرور غير صحيحة.","auth/invalid-credential":"البريد أو كلمة المرور غير صحيحة، أو الحساب ليس في المشروع نفسه.","auth/too-many-requests":"محاولات كثيرة؛ انتظر قليلًا.","auth/operation-not-allowed":"فعّل Email/Password من Sign-in method.","auth/network-request-failed":"تحقق من اتصال الإنترنت."};return m[e?.code]||("رمز الخطأ: "+(e?.code||"غير معروف")+" — "+(e?.message||"حدث خطأ"))}
const err=e=>e?.code==="permission-denied"?"الصلاحيات تمنع العملية؛ راجع Firestore Rules.":e?.code==="storage/unauthorized"?"رفع الصور ممنوع في Storage Rules.":e?.code?.startsWith("auth/")?authError(e):e.message||"حدث خطأ";
async function upload(file,folder){if(!file)return"";if(!file.type.startsWith("image/"))throw Error("اختر صورة");if(file.size>8*1024*1024)throw Error("الصورة أكبر من 8 ميجابايت");const r=ref(storage,folder+"/"+crypto.randomUUID()+"-"+file.name.replace(/[^\w.\-]/g,"_"));await uploadBytes(r,file);return getDownloadURL(r)}
function login(){if($("loginBox"))return;let d=document.createElement("div");d.id="loginBox";d.className="modal";d.innerHTML=`<div class="modalbox" style="max-width:430px"><h2>دخول المدير</h2><div class="field"><label>البريد الإلكتروني</label><input id="email" type="email" autocomplete="username"></div><div class="field"><label>كلمة المرور</label><input id="pass" type="password" autocomplete="current-password"></div><button class="btn primary" id="loginBtn">دخول</button> <button class="btn" id="resetBtn">نسيت كلمة المرور؟</button><p id="loginMsg" class="muted"></p><p class="muted">المشروع: britton-life-store</p></div>`;document.body.append(d);
$("loginBtn").onclick=async()=>{try{let email=$("email").value.trim(),pass=$("pass").value;if(!email||!pass){$("loginMsg").textContent="أدخل البريد وكلمة المرور.";return}await signInWithEmailAndPassword(auth,email,pass);d.remove()}catch(e){$("loginMsg").textContent=authError(e)}};
$("resetBtn").onclick=async()=>{try{let email=$("email").value.trim();if(!email){$("loginMsg").textContent="اكتب بريدك أولًا.";return}await sendPasswordResetEmail(auth,email);$("loginMsg").textContent="أرسلنا رابط إعادة التعيين إلى بريدك. افحص الوارد والرسائل غير المرغوب فيها."}catch(e){$("loginMsg").textContent=authError(e)}}}
window.logout=()=>signOut(auth).then(()=>location.reload());onAuthStateChanged(auth,async u=>{user=u;if(!u){login();$("connection").textContent="بانتظار تسجيل دخول المدير";return}$("loginBox")?.remove();$("connection").textContent="تم تسجيل الدخول";await loadAll()});
async function read(n){let s=await getDocs(collection(db,n));return s.docs.map(d=>({id:d.id,...d.data()}))}
async function loadAll(){try{[products,categories,orders]=await Promise.all([read("products"),read("categories"),read("orders")]);$("countP").textContent=products.length;$("countC").textContent=categories.length;$("countO").textContent=orders.length;renderProducts();renderCategories();renderOrders();$("recent").innerHTML=orders.slice(-5).reverse().map(o=>`<p>${esc(o.customer_name||o.name||"عميل")} — ${Number(o.total||0)}</p>`).join("")||"لا توجد طلبات";await loadSettings()}catch(e){$("connection").textContent="تعذر التحميل: "+err(e)}}
const imgs=p=>Array.isArray(p.images)?p.images.slice(0,3):(p.image_url?[p.image_url]:[]);
function renderProducts(){let q=($("search")?.value||"").toLowerCase();$("productList").innerHTML=products.filter(p=>(p.name||"").toLowerCase().includes(q)).map(p=>`<div class="item"><img class="thumb" src="${esc(imgs(p)[0]||"")}"><div><b>${esc(p.name)}</b><div class="muted">${esc(p.description||"").slice(0,75)} · ${imgs(p).length}/3 صور</div></div><div>${Number(p.price||0)} ر.س</div><div><button class="btn" onclick="openProduct('${p.id}')">تعديل</button> <button class="btn danger" onclick="deleteProduct('${p.id}')">حذف</button></div></div>`).join("")||"لا توجد منتجات"}
function renderCategories(){$("categoryList").innerHTML=categories.map(c=>`<div class="item"><span>▦</span><b>${esc(c.name)}</b><span></span><div><button class="btn" onclick="openCategory('${c.id}')">تعديل</button> <button class="btn danger" onclick="deleteCategory('${c.id}')">حذف</button></div></div>`).join("")||"لا توجد أقسام"}
function renderOrders(){$("orderList").innerHTML=orders.map(o=>`<div class="item"><span>#${esc(o.id)}</span><div>${esc(o.customer_name||o.name||"عميل")}<div class="muted">${esc(o.phone||"")}</div></div><span>${Number(o.total||0)} ر.س</span><select onchange="updateOrder('${o.id}',this.value)"><option ${o.status==="جديد"?"selected":""}>جديد</option><option ${o.status==="قيد التجهيز"?"selected":""}>قيد التجهيز</option><option ${o.status==="تم الشحن"?"selected":""}>تم الشحن</option><option ${o.status==="مكتمل"?"selected":""}>مكتمل</option><option ${o.status==="ملغي"?"selected":""}>ملغي</option></select></div>`).join("")||"لا توجد طلبات"}
window.openProduct=id=>{let p=id?products.find(x=>x.id===id):null,old=imgs(p||{});$("modalTitle").textContent=p?"تعديل المنتج":"إضافة منتج";$("modalBody").innerHTML=`<input id="pId" type="hidden" value="${p?.id||""}"><div class="grid"><div class="field"><label>اسم المنتج</label><input id="pName" value="${esc(p?.name||"")}"></div><div class="field"><label>السعر</label><input id="pPrice" type="number" min="0" step=".01" value="${p?.price??""}"></div><div class="field"><label>المخزون</label><input id="pStock" type="number" min="0" value="${p?.stock??0}"></div><div class="field"><label>القسم</label><select id="pCategory">${categories.map(c=>`<option value="${c.id}" ${p?.categoryId===c.id?"selected":""}>${esc(c.name)}</option>`).join("")}</select></div><div class="field full"><label>وصف المنتج</label><textarea id="pDesc">${esc(p?.description||"")}</textarea></div><div class="field full"><label>صور المنتج — 3 كحد أقصى</label><input id="pFiles" type="file" accept="image/*" multiple><div class="muted">ترك الاختيار فارغًا يحتفظ بالصور الحالية؛ اختيار صور جديدة يستبدلها.</div><div id="previews" class="preview">${old.map(u=>`<img src="${esc(u)}">`).join("")}</div><input id="oldImages" type="hidden" value="${esc(JSON.stringify(old))}"></div><div class="field"><label>الحالة</label><select id="pActive"><option value="true" ${p?.active!==false?"selected":""}>مفعل</option><option value="false" ${p?.active===false?"selected":""}>مخفي</option></select></div></div><button class="btn primary" onclick="saveProduct()">حفظ المنتج</button>`;$("modal").classList.remove("hidden")};
$("modal").addEventListener("change",e=>{if(e.target.id==="pFiles"){let fs=[...e.target.files];if(fs.length>3){msg("مسموح بثلاث صور فقط");e.target.value="";return}$("previews").innerHTML=fs.map(f=>`<img src="${URL.createObjectURL(f)}">`).join("")}});
window.saveProduct=async()=>{try{let name=$("pName").value.trim(),files=[...$("pFiles").files];if(!name)return msg("اكتب اسم المنتج");if(!categories.length)return msg("أضف قسمًا أولًا من صفحة الأقسام");if(!$("pCategory").value)return msg("اختر قسم المنتج");if(Number($("pPrice").value)<0)return msg("السعر لا يمكن أن يكون سالبًا");if(files.length>3)return msg("الحد الأقصى 3 صور");let images=files.length?[]:JSON.parse($("oldImages").value||"[]");for(let f of files)images.push(await upload(f,"products"));images=images.slice(0,3);let cid=$("pCategory").value,cat=categories.find(c=>c.id===cid),data={name,price:Number($("pPrice").value||0),stock:Number($("pStock").value||0),categoryId:cid,category:cat?.slug||cat?.name||"",categoryName:cat?.name||"",description:$("pDesc").value.trim(),images,image_url:images[0]||"",active:$("pActive").value==="true",updatedAt:new Date()};let id=$("pId").value;if(id)await updateDoc(doc(db,"products",id),data);else await addDoc(collection(db,"products"),{...data,createdAt:new Date()});msg("تم حفظ المنتج");closeModal();await loadAll()}catch(e){msg(err(e))}};
window.deleteProduct=async id=>{if(confirm("حذف المنتج؟"))try{await deleteDoc(doc(db,"products",id));await loadAll();msg("تم الحذف")}catch(e){msg(err(e))}};
window.openCategory=id=>{let c=id?categories.find(x=>x.id===id):null;$("modalTitle").textContent=c?"تعديل القسم":"إضافة قسم";$("modalBody").innerHTML=`<input id="cId" type="hidden" value="${c?.id||""}"><div class="field"><label>اسم القسم</label><input id="cName" value="${esc(c?.name||"")}"></div><div class="field"><label>الرابط المختصر</label><input id="cSlug" value="${esc(c?.slug||"")}"></div><button class="btn primary" onclick="saveCategory()">حفظ القسم</button>`;$("modal").classList.remove("hidden")};
window.saveCategory=async()=>{try{let name=$("cName").value.trim();if(!name)return msg("اكتب اسم القسم");let slug=$("cSlug").value.trim()||name;let id=$("cId")?.value;if(id)await updateDoc(doc(db,"categories",id),{name,slug,updatedAt:new Date()});else await addDoc(collection(db,"categories"),{name,slug,active:true,createdAt:new Date()});closeModal();await loadAll();msg("تم حفظ القسم")}catch(e){msg(err(e))}};
window.deleteCategory=async id=>{if(confirm("حذف القسم؟"))try{await deleteDoc(doc(db,"categories",id));await loadAll()}catch(e){msg(err(e))}};
window.updateOrder=async(id,status)=>{try{await updateDoc(doc(db,"orders",id),{status,updatedAt:new Date()});await loadAll();msg("تم تحديث الطلب")}catch(e){msg(err(e))}};
async function loadSettings(){try{let s=await getDoc(doc(db,"settings","store"));if(!s.exists())return;let x=s.data();$("storeName").value=x.name||"BRITTON LIFE";$("storePhone").value=x.phone||"";$("storeEmail").value=x.email||"";$("storeUrl").value=x.url||"https://britton744.github.io/-/";if(x.logo){$("logoPreview").innerHTML=`<img src="${esc(x.logo)}">`;if($("appearanceLogoPreview"))$("appearanceLogoPreview").innerHTML=`<img src="${esc(x.logo)}">`}if(x.background){if($("backgroundUrl"))$("backgroundUrl").value=x.background;if($("backgroundPreview"))$("backgroundPreview").innerHTML=`<img src="${esc(x.background)}">`}}catch(e){}}
window.saveSettings=async()=>{try{let prev=(await getDoc(doc(db,"settings","store"))).data()||{},f=$("logoFile").files[0],logo=f?await upload(f,"settings"):prev.logo||"";await setDoc(doc(db,"settings","store"),{name:$("storeName").value.trim(),phone:$("storePhone").value.trim(),email:$("storeEmail").value.trim(),url:$("storeUrl").value.trim(),logo,updatedAt:new Date()},{merge:true});await loadSettings();msg("تم حفظ الإعدادات")}catch(e){msg(err(e))}};

window.saveAppearance=async()=>{try{
 const prev=(await getDoc(doc(db,"settings","store"))).data()||{};
 const lf=$("appearanceLogo").files[0], bf=$("backgroundFile").files[0];
 const logo=lf?await upload(lf,"settings"):prev.logo||"";
 const background=bf?await upload(bf,"settings/backgrounds"):($("backgroundUrl").value.trim()||prev.background||"");
 await setDoc(doc(db,"settings","store"),{logo,background,updatedAt:new Date()},{merge:true});
 await loadSettings();msg("تم حفظ الشعار والخلفية في Firebase");
 }catch(e){msg(err(e))}};
document.addEventListener("change",e=>{
 if(e.target.id==="appearanceLogo"&&e.target.files[0])$("appearanceLogoPreview").innerHTML=`<img src="${URL.createObjectURL(e.target.files[0])}">`;
 if(e.target.id==="backgroundFile"&&e.target.files[0])$("backgroundPreview").innerHTML=`<img src="${URL.createObjectURL(e.target.files[0])}">`;
});

window.testConnection=async()=>{try{let r=await addDoc(collection(db,"adminTests"),{at:new Date(),uid:user.uid});await deleteDoc(r);msg("الاتصال والكتابة يعملان ✓")}catch(e){msg(err(e))}};
window.closeModal=()=>$("modal").classList.add("hidden");document.querySelectorAll(".nav button").forEach(b=>b.onclick=()=>{document.querySelectorAll("main section").forEach(s=>s.classList.add("hidden"));$(b.dataset.page).classList.remove("hidden");window.scrollTo({top:0,behavior:"smooth"});document.querySelectorAll(".nav button").forEach(x=>x.classList.toggle("active",x===b));$("title").textContent=b.textContent});
</script></body></html>
