<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="theme-color" content="#09051d"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>BRITTON LIFE — لوحة التحكم</title>
<style>
:root{--bg:#09051d;--panel:#171039;--line:#57336d;--pink:#df35b0;--gold:#e8b7f1;--muted:#c6b9d6}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 80% 0,#252b83,transparent 35%),var(--bg);color:#fff;font-family:Arial,Tahoma,sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer}.layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh}.side{padding:18px;background:#0c0820;border-left:1px solid var(--line)}.brand{text-align:center;color:var(--gold);font-size:23px;font-weight:bold;margin:12px}.nav button{display:block;width:100%;text-align:right;background:none;color:#fff;border:0;padding:13px;border-radius:10px;margin:4px 0}.nav button.active,.nav button:hover{background:#34205a}.main{padding:20px;max-width:1400px;width:100%;margin:auto}.top{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}.card,.modalbox{background:linear-gradient(145deg,#21184c,#100b2d);border:1px solid var(--line);border-radius:16px;padding:17px;margin:14px 0}.btn{border:1px solid var(--line);background:#171039;color:#fff;padding:10px 14px;border-radius:10px}.primary{background:linear-gradient(120deg,#3d55ed,#9236e7,#df35b0);border:0;font-weight:bold}.danger{color:#ff9eae}.muted{color:var(--muted);font-size:13px}.hidden{display:none!important}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.stat b{display:block;color:var(--gold);font-size:25px;margin-top:8px}.field{margin:10px 0}.field label{display:block;font-size:13px;color:var(--muted);margin-bottom:6px}.field input,.field textarea,.field select{width:100%;padding:11px;border-radius:10px;border:1px solid var(--line);background:#090621;color:#fff}.field textarea{min-height:100px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.full{grid-column:1/-1}.item{display:grid;grid-template-columns:60px 1fr 100px 160px;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line);min-width:550px}.thumb{width:55px;height:55px;object-fit:cover;border-radius:9px}.preview{display:flex;gap:8px;flex-wrap:wrap}.preview img{width:85px;height:75px;object-fit:cover;border-radius:9px}.modal{position:fixed;inset:0;background:#000b;display:flex;align-items:center;justify-content:center;padding:14px;z-index:5}.modalbox{width:min(760px,100%);max-height:94vh;overflow:auto}.toast{position:fixed;bottom:15px;left:15px;background:#241342;border:1px solid var(--gold);padding:12px;border-radius:10px;display:none;z-index:8}
@media(max-width:760px){.layout{grid-template-columns:1fr}.side{padding:9px}.nav{display:flex;overflow:auto}.nav button{white-space:nowrap;width:auto}.main{padding:10px}.stats{grid-template-columns:repeat(3,1fr)}.grid{grid-template-columns:1fr}.full{grid-column:auto}}

/* Mobile-first touch layout */
@media(max-width:760px){
 html,body{width:100%;max-width:100%;overflow-x:hidden}
 body{font-size:15px;padding-bottom:82px}
 .layout{display:block;min-height:100dvh}
 .side{position:static;padding:8px 10px 5px;border:0;border-bottom:1px solid var(--line);background:#0c0820}
 .brand{font-size:18px;margin:3px 0 8px}
 .brand .muted{font-size:10px}
 .nav{display:flex;gap:7px;overflow-x:auto;overflow-y:hidden;white-space:nowrap;padding:2px 0 8px;scrollbar-width:thin}
 .nav button{flex:0 0 auto;width:auto;min-height:42px;padding:9px 13px;margin:0;border:1px solid #493064;background:#171039;font-size:13px}
 .side>a,.side>button{display:none!important}
 .main{width:100%;max-width:100%;padding:10px 10px 22px;margin:0}
 .top{align-items:center;gap:8px}
 .top h1{font-size:21px;margin:5px 0}
 .top h2{font-size:18px}
 .top>.btn{min-height:44px;padding:10px 12px}
 .card,.modalbox{padding:13px;border-radius:14px;margin:10px 0}
 .stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
 .stat{font-size:13px;min-width:0}
 .stat b{font-size:22px}
 .grid{grid-template-columns:minmax(0,1fr);gap:5px}
 .full{grid-column:auto}
 .field{min-width:0;margin:9px 0}
 .field input,.field textarea,.field select,select,input,textarea{font-size:16px;min-height:45px;max-width:100%}
 .field textarea{min-height:110px}
 .btn,button{min-height:42px}
 .item{display:flex;flex-wrap:wrap;gap:9px;min-width:0;width:100%;padding:12px 0;align-items:center}
 .item>*{min-width:0;max-width:100%}
 .item>div:first-of-type{flex:1 1 150px}
 .item>div:last-child{display:flex;gap:6px;flex-wrap:wrap}
 .thumb{width:62px;height:62px;flex:0 0 62px}
 #search{width:100%;min-height:44px}
 #products .top{flex-wrap:wrap}
 #products .top h2{width:100%}
 #orderList .item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}
 #orderList .item select{grid-column:1/-1;width:100%}
 .modal{align-items:flex-end;padding:0}
 .modalbox{width:100%;max-height:92dvh;border-radius:18px 18px 0 0;margin:0;padding:16px;overflow:auto}
 .modalbox .top{position:sticky;top:-16px;background:#171039;padding:8px 0;z-index:2}
 .preview img{width:72px;height:72px}
 .toast{left:10px;right:10px;bottom:90px;text-align:center}
 /* Fixed bottom app navigation for thumb reach */
 .side .nav{position:fixed;z-index:20;bottom:0;left:0;right:0;margin:0;padding:8px 7px calc(8px + env(safe-area-inset-bottom));background:#0b071b;border-top:1px solid var(--line);box-shadow:0 -6px 20px #0008;overflow-x:auto}
 .side .nav button{font-size:12px;padding:8px 11px;min-height:44px}
}
@media(max-width:380px){
 .main{padding-left:8px;padding-right:8px}
 .stats{grid-template-columns:repeat(2,minmax(0,1fr))}
 .top>.btn{font-size:12px}
 .nav button{font-size:11px!important;padding:8px 9px!important}
}

</style></head>
<body><div class="layout"><aside class="side"><div class="brand">BRITTON LIFE<div class="muted">MASTER CONTROL</div></div>
<nav class="nav"><button class="active" data-page="dashboard">⌂ الرئيسية</button><button data-page="products">▣ المنتجات</button><button data-page="categories">▦ الأقسام</button><button data-page="orders">🛒 الطلبات</button><button data-page="settings">⚙ إعدادات المتجر</button><button data-page="appearance">🎨 المظهر والصور</button></nav>
<a class="btn primary" style="display:block;text-align:center;text-decoration:none;margin-top:16px" href="https://britton744.github.io/-/" target="_blank">↗ فتح المتجر</a><button class="btn" style="width:100%;margin-top:9px" onclick="logout()">تسجيل الخروج</button></aside>
<main class="main"><header class="top"><div><h1 id="title">مركز التحكم</h1><p class="muted">إدارة متجر BRITTON LIFE</p></div><button class="btn primary" onclick="openProduct()">＋ إضافة منتج</button></header>
<section id="dashboard"><div class="stats"><div class="card stat">المنتجات<b id="countP">0</b></div><div class="card stat">الأقسام<b id="countC">0</b></div><div class="card stat">الطلبات<b id="countO">0</b></div></div><div class="card"><h3>حالة الاتصال</h3><div id="connection" class="muted">جاري الاتصال...</div><button class="btn" onclick="testConnection()">اختبار الاتصال</button></div><div class="card"><h3>آخر الطلبات</h3><div id="recent"></div></div></section>
